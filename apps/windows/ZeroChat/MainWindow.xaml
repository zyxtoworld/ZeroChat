<Window
    x:Class="ZeroChat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid ColumnDefinitions="280,*" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Padding="16" Spacing="12">
                <TextBlock Text="ZeroChat" FontSize="22" FontWeight="SemiBold" />
                <Button Content="新对话" HorizontalAlignment="Stretch" />
                <ListView x:Name="ConversationList" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                <AppBarButton Icon="Sync" Label="同步" />
                <AppBarButton Icon="Setting" Label="设置" />
            </CommandBar>

            <ListView Grid.Row="1" x:Name="MessageList" Padding="24" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="16" ColumnSpacing="8">
                <TextBox x:Name="MessageBox" PlaceholderText="输入消息" AcceptsReturn="True" />
                <Button Grid.Column="1" Content="发送" />
            </Grid>
        </Grid>
    </Grid>
</Window>
