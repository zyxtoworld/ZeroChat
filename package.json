{
  "name": "zerochat",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/web-production-build.mjs",
    "build:service-worker": "node scripts/build-service-worker.mjs",
    "check:android-contact-sheet": "node scripts/android-contact-sheet.mjs",
    "check:android-device-selection": "node scripts/android-device-selection-check.mjs",
    "check:android-cloud-sync-smoke": "node scripts/android-cloud-sync-smoke.mjs",
    "check:android-lint": "node scripts/android-debug-build.mjs lintDebug",
    "check:android-release-size": "node scripts/android-release-size-check.mjs",
    "check:android-unit": "node scripts/android-debug-build.mjs testDebugUnitTest",
    "check:android-ui-smoke": "node scripts/android-ui-smoke.mjs",
    "check:apple-contracts": "node --test apps/apple/ContractTests/apple-image-request-cost-contract.test.mjs",
    "check:apple-ipa-size": "node scripts/apple-ipa-size-check.mjs",
    "check:apple-macos-app-size": "node scripts/apple-macos-app-size-check.mjs",
    "check:axe": "node scripts/axe-accessibility-check.mjs",
    "check:bundle": "node scripts/bundle-size-check.mjs",
    "check:browser-smoke": "node scripts/browser-skill-smoke.mjs",
    "check:completion-audit": "node scripts/completion-audit-check.mjs",
    "check:copy": "node scripts/copy-consistency-check.mjs",
    "check:cloud-sync": "node scripts/cloud-sync-e2e-check.mjs",
    "check:deploy": "node scripts/deploy-readiness-check.mjs",
    "check:docs": "node scripts/docs-link-check.mjs",
    "check:gist-sync": "node scripts/gist-sync-e2e-check.mjs",
    "check:hosted-native-ci": "node scripts/hosted-native-ci-evidence-check.mjs",
    "check:hosted-native-ci-report": "node scripts/hosted-native-ci-evidence-check.mjs --report=.manual-qa/hosted-native-ci-evidence.json",
    "check:hosted-native-ci-release-pass": "node scripts/hosted-native-ci-evidence-check.mjs --report=.manual-qa/hosted-native-ci-evidence.json --require",
    "check:i18n": "node scripts/i18n-completeness-check.mjs",
    "check:locale-runtime": "node scripts/locale-runtime-smoke.mjs",
    "check:live-provider-smoke": "node scripts/live-provider-smoke-check.mjs",
    "check:live-provider-report": "node scripts/runtime-smoke-artifact-check.mjs --only-live-provider-api-report --require-live-provider-api-report=.manual-qa/live-provider-smoke-full-current.json",
    "check:live-provider-full-capability": "node scripts/runtime-smoke-artifact-check.mjs --only-live-provider-api-report --require-live-provider-full-capability-report=.manual-qa/live-provider-smoke-full-current.json",
    "check:live-provider-ui-report": "node scripts/release-blocker-report.mjs --check-live-provider-ui-report",
    "check:live-provider-ui-screenshot": "node scripts/runtime-smoke-artifact-check.mjs --only-live-provider-ui-screenshot --require-live-provider-ui-screenshot=.manual-qa/web-live-ui-provider-smoke-current-relay.png",
    "check:strict-release-preflight": "node scripts/runtime-smoke-artifact-check.mjs --only-strict-release-preflight-report --require-strict-release-preflight-report=.manual-qa/strict-release-preflight.json",
    "check:verify-release-checkpoint": "node scripts/runtime-smoke-artifact-check.mjs --only-verify-release-checkpoint-report --require-verify-release-checkpoint=.manual-qa/verify-release-current.json",
    "check:release-blockers": "node scripts/release-blocker-report.mjs --check",
    "check:release-diagnostics": "node scripts/release-diagnostics-refresh.mjs --check",
    "check:current-evidence": "node scripts/release-current-evidence-summary.mjs --check",
    "check:release-report-lock": "node scripts/release-report-lock-check.mjs",
    "check:live-sync-drill": "node scripts/live-sync-release-drill-check.mjs",
    "check:live-sync-report": "node scripts/runtime-smoke-artifact-check.mjs --only-live-sync-report --require-live-sync-report=.manual-qa/live-sync-release-drill-current-diagnostic.json",
    "check:live-sync-release-pass": "node scripts/runtime-smoke-artifact-check.mjs --only-live-sync-report --require-live-sync-passed-report=.manual-qa/live-sync-release-drill.json",
    "check:lighthouse": "node scripts/lighthouse-check.mjs",
    "check:local-cleanup": "node scripts/local-runtime-cleanup-check.mjs",
    "check:linux-contracts": "node --test apps/linux/contract-tests/linux-chat-retry-contract.test.mjs",
    "check:linux-fmt": "node scripts/linux-rustfmt-check.mjs",
    "check:linux-packaging": "node scripts/linux-packaging-check.mjs",
    "check:linux-release-size": "node scripts/linux-release-size-check.mjs",
    "check:chat-context-window": "node scripts/chat-context-window-smoke.mjs",
    "check:composer-autosize": "node scripts/composer-autosize-smoke.mjs",
    "check:message-virtualization": "node scripts/message-virtualization-smoke.mjs",
    "check:native-i18n": "node scripts/native-i18n-check.mjs",
    "check:native-parity": "node scripts/native-parity-check.mjs",
    "check:native-prereqs": "node scripts/native-build-prereq-check.mjs",
    "check:pwa-offline": "node scripts/pwa-offline-smoke.mjs",
    "check:redlines": "node scripts/icon-sync-redline-check.mjs",
    "check:repo": "node scripts/repository-health-check.mjs",
    "check:runtime-artifacts": "node scripts/runtime-smoke-artifact-check.mjs",
    "check:security": "node scripts/worker-security-check.mjs",
    "check:shared-schema": "node scripts/shared-schema-check.mjs",
    "check:service-worker": "node scripts/build-service-worker.mjs --check",
    "check:settings-preload": "node scripts/settings-overlay-preload-smoke.mjs",
    "check:skills": "node scripts/skill-system-check.mjs",
    "check:unit": "vitest run",
    "check:coverage": "node scripts/unit-coverage-check.mjs",
    "check:ui": "node scripts/ui-accessibility-check.mjs",
    "check:windows-shell": "node scripts/windows-webview-shell-check.mjs",
    "check:windows-msix": "node scripts/windows-msix-readiness-check.mjs",
    "check:windows-msix-host-preflight": "node scripts/windows-msix-host-preflight-check.mjs",
    "check:windows-msix-host-preflight-clear": "node scripts/windows-msix-host-preflight-check.mjs --require-clear",
    "check:windows-msix-trusted-report": "node scripts/runtime-smoke-artifact-check.mjs --only-runtime-artifact --require-runtime-artifact=windows-msix-trusted",
    "check:windows-native-contracts": "node scripts/windows-native-contract-check.mjs",
    "audit:supply-chain": "pnpm audit --audit-level=low",
    "audit:supply-chain:prod": "pnpm audit --prod --audit-level=low",
    "audit:visual": "node scripts/visual-audit.mjs",
    "drill:live-provider": "node scripts/live-provider-smoke.mjs",
    "drill:live-provider-ui": "node scripts/live-provider-ui-smoke.mjs",
    "drill:live-provider-ui-local-proxy": "node scripts/live-provider-ui-local-proxy-diagnostic.mjs",
    "drill:live-provider-ui-temporary-worker": "node scripts/cloudflare-temporary-live-provider-ui-drill.mjs",
    "drill:live-sync": "node scripts/live-sync-release-drill.mjs",
    "serve:live-provider-ui-proxy": "node scripts/live-provider-ui-proxy-harness.mjs",
    "build:apple:macos": "cd apps/apple && swift build --product ZeroChatAppleApp && xcodebuild -project ZeroChat.xcodeproj -scheme ZeroChat -destination 'platform=macOS' -derivedDataPath ../../.manual-qa/apple-derived-data CODE_SIGNING_ALLOWED=NO build",
    "build:apple:ios-simulator": "cd apps/apple && xcodebuild -project ZeroChat.xcodeproj -scheme ZeroChat -destination 'generic/platform=iOS Simulator' -derivedDataPath ../../.manual-qa/apple-ios-simulator-derived-data CODE_SIGNING_ALLOWED=NO build",
    "build:apple:debug": "pnpm run build:apple:macos && pnpm run build:apple:ios-simulator",
    "qa:apple": "pnpm run check:native-prereqs -- --platform=apple --report=.manual-qa/native-prereq-apple.json && node scripts/runtime-smoke-artifact-check.mjs --only-native-prereq-report --require-native-prereq=.manual-qa/native-prereq-apple.json && pnpm run build:apple:debug && bash scripts/apple-runtime-smoke.sh .manual-qa/apple-derived-data/Build/Products/Debug/ZeroChat.app && node scripts/runtime-smoke-artifact-check.mjs --only-runtime-artifact --require-runtime-artifact=apple",
    "build:android:debug": "node scripts/android-debug-build.mjs",
    "build:android:release": "node scripts/android-debug-build.mjs assembleRelease",
    "qa:android": "node scripts/android-emulator-qa.mjs",
    "qa:android:current": "node scripts/android-emulator-qa.mjs --skip-build",
    "qa:android:refresh-cloud": "node scripts/android-emulator-qa.mjs --skip-build --reuse-current-ui-smoke",
    "qa:android:reuse-current": "node scripts/android-emulator-qa.mjs --skip-build --reuse-current-smokes",
    "build:linux:release": "cargo build --manifest-path apps/linux/Cargo.toml --release --locked",
    "qa:linux": "pnpm run check:native-prereqs -- --platform=linux --report=.manual-qa/native-prereq-linux.json && node scripts/runtime-smoke-artifact-check.mjs --only-native-prereq-report --require-native-prereq=.manual-qa/native-prereq-linux.json && pnpm run build:linux:release && bash scripts/linux-runtime-smoke.sh apps/linux/target/release/zerochat-linux && node scripts/runtime-smoke-artifact-check.mjs --only-runtime-artifact --require-runtime-artifact=linux",
    "build:windows:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Configuration Release -Platform x64",
    "build:windows:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Configuration Release -Platform x64 -SkipWebBuild -MsixReady",
    "qa:web-current": "node scripts/web-current-page-qa.mjs",
    "qa:windows-webview": "pnpm run build:windows:release && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-webview-runtime-smoke.ps1 -Configuration Release -Platform x64 && node scripts/runtime-smoke-artifact-check.mjs --only-runtime-artifact --require-runtime-artifact=windows",
    "qa:windows": "pnpm run qa:windows-webview && pnpm run build:windows:msix && pnpm run package:windows:msix && pnpm run qa:windows-msix",
    "package:windows:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-msix.ps1 -Configuration Release -Platform x64",
    "qa:windows-msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-msix-install-qa.ps1",
    "qa:windows-msix-trusted": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-msix-trusted-install-update-qa.ps1",
    "qa:windows-msix-trusted:elevated": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-msix-trusted-elevated-rerun.ps1",
    "deploy:cf": "node scripts/deploy-cloudflare-pages.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "report:hosted-native-ci": "node scripts/hosted-native-ci-evidence-report.mjs",
    "report:hosted-native-ci-diagnostic": "node scripts/hosted-native-ci-evidence-check.mjs --refresh-diagnostic --report=.manual-qa/hosted-native-ci-evidence.json",
    "report:live-provider-diagnostic": "node scripts/live-provider-diagnostic-report.mjs",
    "report:native-prereqs": "node scripts/native-prereq-report-refresh.mjs",
    "report:release-diagnostics": "node scripts/release-diagnostics-refresh.mjs",
    "report:release-blockers": "node scripts/release-blocker-report.mjs",
    "report:current-evidence": "node scripts/release-current-evidence-summary.mjs",
    "sync:current-evidence": "node scripts/release-current-evidence-summary.mjs --write-docs",
    "report:strict-release-preflight": "node scripts/strict-release-preflight-report.mjs",
    "report:windows-msix-host-preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-msix-host-preflight.ps1",
    "verify": "node scripts/verify-release.mjs",
    "verify:web-local": "node scripts/verify-release.mjs --web-local",
    "verify:release": "node scripts/verify-release.mjs --release",
    "verify:release:live-sync": "node scripts/verify-release.mjs --release --require-live-sync-pass",
    "verify:all-platforms": "node scripts/verify-release.mjs --all-platforms",
    "verify:all-platforms:live-sync": "node scripts/verify-release.mjs --all-platforms --require-live-sync-pass",
    "verify:all-platforms:runtime": "node scripts/verify-release.mjs --all-platforms --require-native-runtime-artifacts",
    "verify:all-platforms:runtime-live-sync": "node scripts/verify-release.mjs --all-platforms --require-native-runtime-artifacts --require-live-sync-pass",
    "verify:all-platforms:runtime-live-sync-hosted": "node scripts/verify-release.mjs --all-platforms --require-native-runtime-artifacts --require-live-sync-pass --require-hosted-native-ci-evidence",
    "verify:all-platforms:runtime-live-sync-hosted-provider": "node scripts/verify-release.mjs --all-platforms --require-native-runtime-artifacts --require-live-sync-pass --require-hosted-native-ci-evidence --require-live-provider-full-capability"
  },
  "dependencies": {
    "lucide-react": "^1.26.0",
    "marked": "18.0.7",
    "preact": "^10.29.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "lighthouse": "^13.4.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@sentry/node": "10.68.0",
    "brace-expansion": "5.0.8"
  }
}
